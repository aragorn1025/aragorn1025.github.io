{
	"arrowParens": "always",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"endOfLine": "lf",
	"printWidth": 120,
	"semi": true,
	"singleQuote": true,
	"tabWidth": 2,
	"trailingComma": "all",
	"useTabs": false,
	"overrides": [
		{
			"files": [".prettierrc", "*.json"],
			"excludeFiles": ["package.json", "package-lock.json", "tsconfig.json", "tsconfig.node.json"],
			"options": {
				"tabWidth": 4,
				"useTabs": true
			}
		}
	]
}
